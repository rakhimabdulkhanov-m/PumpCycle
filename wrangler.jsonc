{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pumpcycle",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  // Custom domains (demo.pumpcycle.net, app.pumpcycle.net, ...) are attached by hand
  // in the dashboard after the first deploy. Deliberately no "routes"/"route" key here.

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unmatched paths serve index.html so the SPA can boot and route client-side.
    "not_found_handling": "single-page-application",
    // Without this the assets layer answers first and every /api/* path 404s.
    // "/api" is listed separately: "/api/*" does not match the bare path, and without it
    // GET /api answers 200 + index.html from the assets layer.
    "run_worker_first": ["/api", "/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Hourly, NOT once a day. A single daily UTC trigger is 9am Eastern in summer
  // and 8am in winter, bakes one client's timezone into deploy config, and makes
  // a missed run wait 24 hours. The handler returns immediately unless the
  // tenant's own local hour matches its reminder_send_hour setting.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // Public unauthenticated endpoint that triggers an outbound fetch -> amplification target.
  // 3 requests / 60s per client IP. period must be 10 or 60 (wrangler schema enum).
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "9021",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    // Address lookups get their own budget. /api/lead is a stranger submitting
    // one form, so 3/60s is generous there. Geocoding is an owner adding
    // customers off a paper book during setup week: four new addresses in a
    // minute is ordinary work, and sharing the lead budget would 429 him on the
    // fourth behind copy that reads like his address was wrong.
    {
      "name": "GEOCODE_RATE_LIMITER",
      "namespace_id": "9022",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    // Sign-in has a separate namespace so public lead/geocode traffic cannot
    // consume an owner's login budget. Account lockout remains the second layer.
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "9023",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],

  // D1 databases. One entry per live tenant plus any non-production databases.
  // binding = env key used in Worker code; database_name = D1 name in Cloudflare dashboard.
  // migrations_dir is read by wrangler d1 migrations and by vitest-pool-workers (Miniflare)
  // to apply the schema automatically in test runs.
  "d1_databases": [
    {
      "binding": "DB_DEV",
      "database_name": "pumpcycle-dev",
      "database_id": "a8e4fbe3-fed7-4eea-8d58-3a928fc52634",
      "migrations_dir": "migrations"
    }
  ]

  // DEV_TENANT_HOST overrides the hostname used for tenant resolution. It is deliberately
  // NOT declared here: shipping it as a production var makes "which client's data does this
  // request see" settable from the dashboard. resolveTenant() handles it being undefined.
  // It lives only in .dev.vars, for local wrangler dev.
}
